#include "ui_mp/menudef.h"

#define MOD_HAS_PREVIEW (dvarint("ui_codxe_mod_has_preview") != 0)
#define MOD_HAS_AUTHOR (dvarstring("ui_codxe_mod_author") != "")
#define MOD_HAS_REVISION (dvarstring("ui_codxe_mod_revision") != "")
#define MOD_HAS_CREDITS (MOD_HAS_AUTHOR || MOD_HAS_REVISION)
#define MOD_TITLE_Y (38 + MOD_HAS_PREVIEW * 149)
#define MOD_CREDITS_Y (MOD_TITLE_Y + 32)
#define MOD_SECOND_ROW ((MOD_HAS_AUTHOR && MOD_HAS_REVISION) * 17)
#define MOD_DESCRIPTION_Y (MOD_CREDITS_Y + MOD_HAS_CREDITS * 42 + MOD_SECOND_ROW)

// Use the stock map selector's safe-area frame and background layers.
{
    menuDef
    {
        name "mods_menu"
        fullscreen 1
        rect 0 0 640 480 0 0
        style 1
        focuscolor 1 1 1 1
        soundLoop "music_mainmenu_mp"
        onOpen
        {
            uiScript LoadMods;
            setfocus mods_list;
        }
        onESC
        {
            close self;
        }

        itemDef
        {
            rect                        0 0 640 480 4 4
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            background                  "mw2_main_background"
        }
        itemDef
        {
            rect                        0 0 1708 480 0 0
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            forecolor                   1 1 1 0.5
            background                  "mw2_main_cloud_overlay"
            exp rect x                  ((0 - 107) - ((float(milliseconds() % 60000) / 60000) * (854)));
        }
        itemDef
        {
            rect                        0 0 -1708 -480 0 0
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            forecolor                   1 1 1 0.5
            background                  "mw2_main_cloud_overlay"
            exp rect x                  ((- 107 + 854) + ((float(milliseconds() % 50000) / 50000) * (854)));
        }
        itemDef
        {
            rect                        0 0 640 480 4 4
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            forecolor                   1 1 1 0
            background                  "mockup_bg_glow"
            exp forecolor a             (((sin(milliseconds() / 1500) + 1) * 0.25) + 0.25);
        }
        itemDef
        {
            rect                        0 0 640 480 4 4
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            forecolor                   1 1 1 0
            background                  "mockup_bg_glow"
            exp forecolor a             (((sin(milliseconds() / 480) + 1) * 0.25) + 0.25);
        }
        itemDef
        {
            rect                        0 28 640 356 4 1
            style                       3
            decoration
            visible                     1
            textscale                   0.55
            forecolor                   1 1 1 0.15
            background                  "white"
        }
        itemDef
        {
            rect                        -32 -4 32 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_tl"
        }
        itemDef
        {
            rect                        0 -4 640 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_t"
        }
        itemDef
        {
            rect                        640 -4 32 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_tr"
        }
        itemDef
        {
            rect                        640 28 32 356 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_r"
        }
        itemDef
        {
            rect                        640 384 32 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_br"
        }
        itemDef
        {
            rect                        0 384 640 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_b"
        }
        itemDef
        {
            rect                        -32 384 32 32 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_bl"
        }
        itemDef
        {
            rect                        -32 28 32 356 4 1
            style                       3
            decoration
            visible                     when(1);
            textscale                   0.55
            forecolor                   0 0 0 1
            background                  "drop_shadow_l"
        }

        execKeyInt BUTTON_X
        {
            uiScript ClearMods;
        }
        itemDef
        {
            text "MODS"
            rect 0 0 272 28 1 1
            decoration
            visible 1
            textfont 9
            textscale 0.5
        }
        itemDef
        {
            name "mods_list"
            rect -64 28 336 356 1 1
            type ITEM_TYPE_LISTBOX
            style 1
            visible when(dvarint(ui_modCount) > 0);
            textfont 3
            textscale 0.375
            textalignx -25
            textaligny 1
            outlinecolor 0 0 0 1
            elementwidth 300
            elementheight 18
            feeder FEEDER_MODS
            usepaging
            columns 2
                    0 300 63 2
                    313 18 1 0
            selectBorder 0 0 0 0
            onFocus { play mouse_over; }
            doubleclick { play mouse_click; uiScript RunMod; }
        }
        itemDef
        {
            text "No mods installed."
            rect 0 60 272 44 1 1
            decoration
            visible when(dvarint(ui_modCount) == 0);
            textfont 3
            textscale 0.375
        }
        itemDef
        {
            rect -292 28 292 356 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible 1
            forecolor 0 0 0 0.7
            background "black"
        }
        itemDef
        {
            name "mod_preview"
            rect -282 38 272 132 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible when(MOD_HAS_PREVIEW);
            exp material ("$codxe_mod_preview");
        }
        itemDef
        {
            name "mod_title"
            rect -282 38 272 30 3 1
            decoration
            autowrapped
            visible when(dvarstring("ui_codxe_mod_name") != "");
            exp rect Y (MOD_TITLE_Y);
            textalign 4
            textscale 0.375
            textfont 9
            forecolor 1 1 1 1
            exp text (dvarstring("ui_codxe_mod_name"));
        }
        itemDef
        {
            rect -282 70 60 17 3 1
            decoration
            visible when(MOD_HAS_AUTHOR);
            exp rect Y (MOD_CREDITS_Y);
            textalign 4
            textscale 0.375
            textfont 3
            forecolor 0.69 0.69 0.69 1
            text "Author:"
        }
        itemDef
        {
            rect -222 70 212 17 3 1
            decoration
            visible when(MOD_HAS_AUTHOR);
            exp rect Y (MOD_CREDITS_Y);
            textalign 4
            textscale 0.375
            textfont 3
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_mod_author"));
        }
        itemDef
        {
            rect -282 70 60 17 3 1
            decoration
            visible when(MOD_HAS_REVISION);
            exp rect Y (MOD_CREDITS_Y + MOD_HAS_AUTHOR * 17);
            textalign 4
            textscale 0.375
            textfont 3
            forecolor 0.69 0.69 0.69 1
            text "Revision:"
        }
        itemDef
        {
            rect -222 70 212 17 3 1
            decoration
            visible when(MOD_HAS_REVISION);
            exp rect Y (MOD_CREDITS_Y + MOD_HAS_AUTHOR * 17);
            textalign 4
            textscale 0.375
            textfont 3
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_mod_revision"));
        }
        itemDef
        {
            rect -282 92 272 1 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible when(MOD_HAS_CREDITS && dvarstring("ui_codxe_mod_description") != "");
            exp rect Y (MOD_CREDITS_Y + 22 + MOD_SECOND_ROW);
            forecolor 0.5 0.5 0.5 0.4
            background "white"
        }
        itemDef
        {
            name "mod_description"
            rect -282 70 272 280 3 1
            decoration
            autowrapped
            visible when(dvarstring("ui_codxe_mod_description") != "");
            exp rect Y (MOD_DESCRIPTION_Y);
            exp rect H (350 - MOD_DESCRIPTION_Y);
            textalign 4
            textscale 0.375
            textfont 3
            forecolor 0.69 0.69 0.69 1
            exp text (dvarstring("ui_codxe_mod_description"));
        }
        itemDef
        {
            rect -282 355 272 25 3 1
            decoration
            autowrapped
            visible when(dvarstring(fs_game) != "");
            textfont 3
            textscale 0.375
            exp text ("Active mod: " + dvarstring(fs_game));
        }
        itemDef
        {
            text "@PLATFORM_BACK_CAPS"
            rect -64 -20 336 24 1 3
            decoration
            visible 1
            textalign 6
            textalignx -30
            textfont 3
            textscale 0.375
        }
        itemDef
        {
            text " Disable mod"
            rect -292 -20 292 24 3 3
            decoration
            visible 1
            textalign 4
            textalignx 10
            textfont 3
            textscale 0.375
        }
    }
}
