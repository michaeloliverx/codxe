        }
        itemDef
        {
            name "usermap_description"
            rect -200 235 200 120 3 1
            decoration
            autowrapped
            visible when(dvarint("settings_usermaps_selected"));
            textscale 0.3095
            textstyle ITEM_TEXTSTYLE_SHADOWED
