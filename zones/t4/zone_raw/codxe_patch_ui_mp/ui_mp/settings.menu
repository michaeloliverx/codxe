        }
        itemDef
        {
            name "chosen_usermap_title"
            rect -200 200 200 100 3 1
            decoration
            autowrapped
            visible when(!dvarint("settings_usermaps_selected") && (dvarstring("ui_mapname") != "" && dvarstring("ui_mapname") == dvarstring("ui_codxe_usermap_mapname")));
            textscale 0.381
            textstyle ITEM_TEXTSTYLE_SHADOWED
            textfont UI_FONT_NORMAL
            forecolor 0.95294 0.72156 0.21176 1
