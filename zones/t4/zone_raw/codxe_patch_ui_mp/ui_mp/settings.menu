#include "ui_mp/menudef.h"

{
    menuDef
    {
        name                        "settings"
        rect                        0 0 640 470 4 4
        style                       1
        borderSize                  1
        focuscolor                  0.95294 0.72156 0.21176 1
        soundLoop                   "music_mainmenu"
        fadeClamp                   1
        fadeCycle                   1
        fadeAmount                  0.1
        onOpen
        {
            setdvar invite_visible 0;
            setdvar settings_map_selected 0;
            setdvar settings_usermaps_selected 0;
            setdvar settings_gametype_selected 0;
        }
        onClose
        {
            uiScript CloseUsermaps;
            setdvar settings_usermaps_selected 0;
            setdvar invite_visible 1;
            setDvar ui_preview dvarString ( ui_mapname );
        }
        onESC
        {
            close self;
        }
