            noscrollbars
            elementwidth                20
            elementheight               22
            feeder                      53
            columns                     1
                                        25 190 64 0
            doubleclick
            {
                play mouse_click;
                setdvar settings_gametype_selected 0;
                setfocus change_gametype;
                execNow xupdatepartystate;
                exec "exec default_xboxlive.cfg";
            }
            onListboxSelectionChange
            {
                play mouse_over;
            }
            selectBorder                0.8 0.95 1 0
            disableColor                0.34118 0.36863 0.37647 1
            focusColor                  1 1 1 1
            selectIcon                  "ui_button_xenon_3d_a_32x32"
            highlightTexture            "menu_button_backing_highlight"
        }
        itemDef
        {
            rect                        0 137 183.5 22 1 1
            style                       3
            decoration
            borderSize                  1
            visible                     when(dvarint("settings_map_selected") == 0 && dvarint("settings_gametype_selected") == 0 && dvarint("settings_usermaps_selected") == 0);
            textscale                   0.55
            forecolor                   0.1 0.1 0.1 0.5
            exp material                ("menu_button_backing");
        }
        itemDef
        {
            rect                        0 137 183.5 22 1 1
            style                       3
            decoration
            borderSize                  2
            visible                     when(localvarint("ui_highlight") == 4 && localvarstring("ui_choicegroup") == "" && 1);
            textscale                   0.55
            forecolor                   0.9 0.95 1 0.5
            bordercolor                 0.8 0.95 1 0.4
            background                  "menu_button_backing_highlight"
        }
        itemDef
        {
            text                        "@PLATFORM_UI_SELECTBUTTON"
            rect                        0 138 189 22 1 1
            decoration
            borderSize                  1
            visible                     when(localvarint("ui_highlight") == 4 && localvarstring("ui_choicegroup") == "" && 1);
            textalign                   8
            textaligny                  -1
            textscale                   0.4
            textfont                    1
        }
        itemDef
        {
            rect                        0 137 189 22 1 1
            type                        1
            borderSize                  1
            visible                     when(dvarint("settings_map_selected") == 0 && dvarint("settings_gametype_selected") == 0 && dvarint("settings_usermaps_selected") == 0);
            textalign                   8
            textalignx                  22
            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            onFocus
            {
                play mouse_over;
                setLocalVarInt ui_highlight 4;
                setLocalVarString ui_choicegroup "";
            }
            leaveFocus
            {
                setLocalVarInt ui_highlight 0;
            }
            action
            {
                play mouse_click;
                uiScript openMenuOnDvar ui_gametype tdm settings_quick_tdm;
                uiScript openMenuOnDvar ui_gametype sd settings_quick_sd;
                uiScript openMenuOnDvar ui_gametype sab settings_quick_sab;
                uiScript openMenuOnDvar ui_gametype dm settings_quick_dm;
                uiScript openMenuOnDvar ui_gametype dom settings_quick_dom;
                uiScript openMenuOnDvar ui_gametype ctf settings_quick_ctf;
                uiScript openMenuOnDvar ui_gametype koth settings_quick_koth;
                uiScript openMenuOnDvar ui_gametype twar settings_quick_twar;
                uiScript openMenuOnDvar ui_gametype ctf settings_quick_ctf;
                uiScript openMenuOnDvar ui_gametype sur settings_quick_sur;
            }
            exp text                    ("@MPUI_GAME_RULES");
        }
        itemDef
        {
            rect                        0 137 183.5 22 1 1
            style                       3
            decoration
            borderSize                  1
            visible                     when(dvarint("settings_map_selected") || dvarint("settings_gametype_selected") || dvarint("settings_usermaps_selected"));
            textscale                   0.55
            forecolor                   0.1 0.1 0.1 0.5
            exp material                ("menu_button_backing");
        }
        itemDef
        {
            rect                        0 137 189 22 1 1
            type                        1
            borderSize                  1
            visible                     when(dvarint("settings_map_selected") || dvarint("settings_gametype_selected") || dvarint("settings_usermaps_selected"));
            textalign                   8
            textalignx                  22
            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.3 0.3 0.3 1
            onFocus
            {
                play mouse_over;
                setLocalVarInt ui_highlight 4;
                setLocalVarString ui_choicegroup "";
            }
            leaveFocus
            {
                setLocalVarInt ui_highlight 0;
            }
            action
            {
                play mouse_click;
            }
            exp text                    ("@MPUI_GAME_RULES");
        }
        itemDef
        {
            rect                        244 52 10 10 1 1
            style                       3
            decoration
            visible                     when(dvarbool("settings_map_selected") && dvarint("ui_mapCount") > 14);
            textscale                   0.55
            exp material                ("ui_scrollbar_arrow_up_a");
        }
        itemDef
        {
            rect                        244 374 10 10 1 1
            style                       3
            decoration
            visible                     when(dvarbool("settings_map_selected") && dvarint("ui_mapCount") > 14);
            textscale                   0.55
            exp material                ("ui_scrollbar_arrow_dwn_a");
        }
        itemDef
        {
            name "usermap_preview"
            rect -200 65 200 100 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible when((dvarint("settings_usermaps_selected") || (dvarstring("ui_mapname") != "" && dvarstring("ui_mapname") == dvarstring("ui_codxe_usermap_mapname"))) && dvarint("ui_codxe_usermap_has_preview"));
            background "$codxe_usermap_preview"
        }
        itemDef
        {
            name "usermap_title"
            rect -200 185 200 32 3 1
            decoration
            autowrapped
