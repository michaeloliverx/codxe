#include "ui_mp/menudef.h"

#define MOD_HAS_PREVIEW (dvarint("ui_codxe_mod_has_preview") != 0)
#define MOD_HAS_AUTHOR (dvarstring("ui_codxe_mod_author") != "")
#define MOD_HAS_REVISION (dvarstring("ui_codxe_mod_revision") != "")
#define MOD_HAS_CREDITS (MOD_HAS_AUTHOR || MOD_HAS_REVISION)
#define MOD_TITLE_Y (66 + MOD_HAS_PREVIEW * 126)
#define MOD_CREDITS_Y (MOD_TITLE_Y + 8 + dvarint("ui_codxe_mod_title_wrap_height"))
#define MOD_SECOND_ROW ((MOD_HAS_AUTHOR && MOD_HAS_REVISION) * 16)
#define MOD_DESCRIPTION_Y (MOD_CREDITS_Y + MOD_HAS_CREDITS * 42 + MOD_SECOND_ROW)

{
    menuDef
    {
        name                        "mods_menu"
        fullscreen                  1
        rect                        0 0 640 480 0 0
        focuscolor                  0.95294 0.72156 0.21176 1
        soundLoop                   "music_mainmenu"
        onOpen
        {
            uiScript LoadMods;
            setfocus mod_list;
        }
        onESC
        {
            close self;
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            background                  "menu_background_mp_tank"
        }
        itemDef
        {
            rect                        -107 0 1708 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            background                  "animbg_fogscrollthin"
            exp rect X                  ((- 961) + ((float(milliseconds() % 50000) / 50000) * (854)));
        }
        itemDef
        {
            rect                        -107 0 854 66 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            background                  "menu_black_line"
        }
        itemDef
        {
            rect                        -107 420 854 70 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            background                  "menu_black_line"
        }
        itemDef
        {
            rect                        -5 40 640 25 4 4
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            forecolor                   0.2137 0.2346 0.2398 0.75
            background                  "menu_lobby_title_back"
        }
        itemDef
        {
            rect                        -107 65 854 1 4 4
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            forecolor                   0.2 0.216 0.22 1
            background                  "menu_white_line_faded"
        }
        itemDef
        {
            rect                        22 5 100 100 1 1
            decoration
            visible                     1
            textalign                   4
            textscale                   0.5476
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            text                        "@CODXE_MODS"
        }
        itemDef
        {
            name                        "mod_list"
            rect                        3 43 238 310 1 1
            type                        ITEM_TYPE_LISTBOX
            visible                     1
            textscale                   0.381
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            forecolor                   0.69 0.69 0.69 1
            outlinecolor                0.9 0.95 1 0.5
            noscrollbars
            // T4 uses one ninth of elementwidth as the selectIcon's left offset.
            elementwidth                27
            elementheight               22
            feeder                      FEEDER_MODS
            columns                     1
                                        18 216 64 0
            doubleclick
            {
                play mouse_click;
                uiScript RunMod;
                close self;
            }
            onListboxSelectionChange
            {
                play mouse_over;
            }
            selectBorder                0.8 0.95 1 0
            focusColor                  1 1 1 1
            selectIcon                  "ui_button_xenon_3d_a_32x32"
            highlightTexture            "menu_button_backing_highlight"
        }
        itemDef
        {
            rect                        22 45 216 22 1 1
            decoration
            visible                     when(dvarint("ui_modCount") == 0);
            textalign                   8
            textscale                   0.381
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            forecolor                   0.69 0.69 0.69 1
            text                        "@CODXE_NO_MODS"
        }
        itemDef
        {
            name "mod_preview"
            rect -275 43 275 128 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible when(MOD_HAS_PREVIEW);
            background "$codxe_mod_preview"
        }
        itemDef
        {
            name "mod_title"
            rect -275 66 275 30 3 1
            decoration
            autowrapped
            visible when(dvarstring("ui_codxe_mod_name") != "");
            exp rect Y (MOD_TITLE_Y);
            textscale 0.381
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.95294 0.72156 0.21176 1
            exp text (dvarstring("ui_codxe_mod_name"));
        }
        itemDef
        {
            rect -275 75 60 16 3 1
            decoration
            visible when(MOD_HAS_AUTHOR);
            exp rect Y (MOD_CREDITS_Y);
            textalign 8
            textscale 0.3095
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            text "Author:"
        }
        itemDef
        {
            rect -215 75 215 16 3 1
            decoration
            visible when(MOD_HAS_AUTHOR);
            exp rect Y (MOD_CREDITS_Y);
            textalign 8
            textscale 0.3095
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_mod_author"));
        }
        itemDef
        {
            rect -275 75 60 16 3 1
            decoration
            visible when(MOD_HAS_REVISION);
            exp rect Y (MOD_CREDITS_Y + MOD_HAS_AUTHOR * 16);
            textalign 8
            textscale 0.3095
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            text "Revision:"
        }
        itemDef
        {
            rect -215 75 215 16 3 1
            decoration
            visible when(MOD_HAS_REVISION);
            exp rect Y (MOD_CREDITS_Y + MOD_HAS_AUTHOR * 16);
            textalign 8
            textscale 0.3095
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_mod_revision"));
        }
        itemDef
        {
            rect -275 97 275 1 3 1
            style WINDOW_STYLE_SHADER
            decoration
            visible when(MOD_HAS_CREDITS && dvarstring("ui_codxe_mod_description") != "");
            exp rect Y (MOD_CREDITS_Y + 22 + MOD_SECOND_ROW);
            forecolor 0.5 0.5 0.5 0.4
            background "menu_white_line_faded"
        }
        itemDef
        {
            name "mod_description"
            rect -275 75 275 280 3 1
            decoration
            autowrapped
            visible when(dvarstring("ui_codxe_mod_description") != "");
            exp rect Y (MOD_DESCRIPTION_Y);
            exp rect H (355 - MOD_DESCRIPTION_Y);
            textscale 0.3095
            textfont UI_FONT_NORMAL
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            exp text (dvarstring("ui_codxe_mod_description"));
        }
        itemDef
        {
            rect                        22 365 550 22 1 1
            decoration
            visible                     when(dvarstring("fs_game") != "");
            textalign                   8
            textscale                   0.3095
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            forecolor                   0.69 0.69 0.69 1
            exp text                    (locString("@CODXE_ACTIVE_MOD") + dvarstring("fs_game"));
        }
        itemDef
        {
            rect                        0 -20 16 16 1 3
            style                       WINDOW_STYLE_SHADER
            decoration
            visible                     1
            background                  "ui_arrow_left"
        }
        itemDef
        {
            rect                        18 -4 0 0 1 3
            decoration
            visible                     1
            textalign                   12
            textscale                   0.3095
            textfont                    UI_FONT_NORMAL
            text                        "@PLATFORM_BACK"
        }
        itemDef
        {
            rect                        90 -4 0 0 1 3
            decoration
            visible                     1
            textalign                   12
            textscale                   0.3095
            textfont                    UI_FONT_NORMAL
            text                        "@CODXE_CLEAR_MOD"
            execKeyInt BUTTON_A
            {
                play mouse_click;
                uiScript RunMod;
                close self;
            }
            execKeyInt 13
            {
                uiScript RunMod;
                close self;
            }
            execKeyInt BUTTON_Y
            {
                play mouse_click;
                uiScript ClearMods;
                close self;
            }
            execKeyInt BUTTON_B
            {
                close self;
            }
        }
    }
}
