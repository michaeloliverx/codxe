            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            onFocus
            {
                play mouse_over;
                setLocalVarInt ui_highlight 2;
                setLocalVarString ui_choicegroup systemlink;
            }
            leaveFocus
