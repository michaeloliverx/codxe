{
    menuDef
    {
        name                        "menu_gamesetup_systemlink"
        fullscreen                  1
        rect                        0 0 640 480 0 0
        style                       1
        borderSize                  1
        focuscolor                  0.95294 0.72156 0.21176 1
        soundLoop                   "music_mainmenu"
        fadeClamp                   1
        fadeCycle                   1
        fadeAmount                  0.1
        onOpen
        {
            focusFirst;
            uiScript LoadOfflineStats;
            exec "exec dvar_defaults.cfg";
        }
        onESC
        {
            exec splitscreencontrols;
            setdvar systemlink 0;
            close menu_gamesetup_systemlink;
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       3
            decoration                  
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "menu_background_mp_tank"
        }
        itemDef
        {
            rect                        -107 0 1708 480 0 0
            style                       3
            decoration                  
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_fogscrollthin"
            exp rect X                  ((- 961) + ((float(milliseconds() % 50000) / 50000) * (854)));
        }
        itemDef
        {
            rect                        -107 0 854 66 0 0
            style                       3
            decoration                  
            borderSize                  1
