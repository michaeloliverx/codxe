            bordercolor                 0.8 0.95 1 0.4
            background                  "menu_button_backing_highlight"
        }
        itemDef
        {
            text                        "@PLATFORM_UI_SELECTBUTTON"
            rect                        0 46 224 22 1 1
            decoration                  
            borderSize                  1
            visible                     when(localvarint("ui_highlight") == 1 && localvarstring("ui_choicegroup") == "systemlink" && 1);
            textalign                   8
            textaligny                  -1
            textscale                   0.4
            textfont                    1
        }
        itemDef
        {
            rect                        0 45 224 22 1 1
            type                        1
            borderSize                  1
            visible                     1
            textalign                   8
            textalignx                  22
            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            onFocus
            {
                play mouse_over;
                setLocalVarInt ui_highlight 1;
                setLocalVarString ui_choicegroup systemlink;
            }
            leaveFocus
            {
                setLocalVarInt ui_highlight 0;
            }
            action
            {
                play mouse_click;
                exec "selectStringTableEntryInDvar mp/didyouknow.csv 0 didyouknow";
                uiScript StartServer;
            }
            exp text                    ("@MPUI_START_MATCH");
        }
