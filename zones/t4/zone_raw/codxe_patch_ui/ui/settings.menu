            execKeyInt 2
            {
                setdvar settings_gametype_selected 0;
                setdvar ui_mapname dvarString ( ui_preview_map );
                setdvar ui_gametype dvarString ( ui_preview );
                setfocus change_gametype;
            }
            noscrollbars
            elementwidth                20
            elementheight               23
            feeder                      53
            columns                     1
                                        22 190 64 0
            doubleclick
            {
                play mouse_click;
                setdvar ui_codxe_usermap_active 0;
                setdvar settings_gametype_selected 0;
                setfocus change_gametype;
                execNow xupdatepartystate;
                execNow "set ui_gametypechanged 1";
                execOnDvarStringValue ui_gametype cmp "set arcademode 1; set zombiemode 0; set ui_hostOptionsEnabled 0; set ui_mapname mak";
                execOnDvarStringValue ui_gametype cmp "set ui_preview_map mak";
                execOnDvarStringValue ui_gametype zom "set arcademode 0; set zombiemode 1; set ui_hostOptionsEnabled 0; set ui_mapname nazi_zombie_prototype";
                execOnDvarStringValue ui_gametype zom "set ui_preview_map nazi_zombie_prototype";
            }
