#define HAS_MAP_AUTHOR (dvarstring("ui_codxe_usermap_author") != "")
#define HAS_MAP_REVISION (dvarstring("ui_codxe_usermap_revision") != "")
#define HAS_MAP_METADATA (HAS_MAP_AUTHOR || HAS_MAP_REVISION)
#define MAP_METADATA_SECOND_ROW ((HAS_MAP_AUTHOR && HAS_MAP_REVISION) * 18)
#define MAP_DESCRIPTION_Y (56 + HAS_MAP_METADATA * 34 + MAP_METADATA_SECOND_ROW)

{
    menuDef
    {
        name                        "codxe_usermaps"
        rect                        0 0 640 470 4 4
        style                       1
        borderSize                  1
        focuscolor                  0.95294 0.72156 0.21176 1
        fadeClamp                   1
        fadeCycle                   1
        fadeAmount                  0.1
        onOpen
        {
            setfocus codxe_usermap_list;
        }
        onESC
        {
            close self;
        }
        itemDef
        {
            text                        ""
            rect                        0 0 0 0 0 0
            decoration
            visible                     1
            execKeyInt 2
            {
                close codxe_usermaps;
            }
        }
        itemDef
        {
            rect                        -600 -800 2000 2000 0 0
            style                       3
            decoration
            visible                     1
            forecolor                   0 0 0 0.65
            background                  "white"
        }
        itemDef
        {
            rect                        0 40 640 25 4 4
            style                       3
            decoration
            visible                     1
            forecolor                   0 0 0 1
            background                  "white"
        }
        itemDef
        {
            rect                        -5 40 640 25 4 4
            style                       3
            decoration
            visible                     1
            forecolor                   0.2137 0.2346 0.2398 0.75
            background                  "menu_lobby_title_back"
        }
        itemDef
        {
            rect                        0 64 640 1 4 4
            style                       3
            decoration
            visible                     1
            forecolor                   0.5 0.5 0.5 0.65
            background                  "menu_white_line_faded"
        }
        itemDef
        {
            rect                        0 65 640 355 4 4
            style                       3
            decoration
            visible                     1
            background                  "menu_background_coop_blurred"
        }
        itemDef
        {
            rect                        22 5 100 100 1 1
            decoration
            visible                     1
            textalign                   4
            textscale                   0.5476
            textstyle                   6
            textfont                    1
            text                        "CUSTOM MAPS"
        }
        itemDef
        {
            name                        "codxe_usermap_list"
            rect                        3 52 264 320 1 1
            type                        6
            borderSize                  1
            visible                     1
            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            outlinecolor                0.9 0.95 1 0.5
            noscrollbars
            // The engine shifts the A glyph left by one ninth of the element width.
            elementwidth                27
            elementheight               20
            feeder                      65
            columns                     1
                                        19 226 64 0
            doubleclick
            {
                play mouse_click;
                setdvar ui_codxe_usermap_activate 1;
                close codxe_usermaps;
            }
            onListboxSelectionChange
            {
                play mouse_over;
            }
            selectBorder                0.8 0.95 1 0
            disableColor                0.34118 0.36863 0.37647 1
            focusColor                  1 1 1 1
            selectIcon                  "ui_button_xenon_3d_a_32x32"
            highlightTexture            "menu_button_backing_highlight"
        }
        itemDef
        {
            rect                        23 54 226 20 1 1
            decoration
            visible                     when(dvarstring("ui_codxe_usermap_count") == "0");
            textalign                   8
            textscale                   0.381
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            exp text                    (dvarstring("ui_codxe_usermap_name"));
        }
        itemDef
        {
            // Match the stock Zombies preview frame and preserve the 2:1 artwork inside it.
            rect                        0 -155 275 164 2 2
            style                       3
            decoration
            visible                     when(dvarstring("ui_codxe_usermap_count") != "0");
            forecolor                   0 0 0 0.65
            background                  "white"
        }
        itemDef
        {
            rect                        0 -141.75 275 137.5 2 2
            style                       3
            decoration
            visible                     when(dvarbool("ui_codxe_usermap_has_preview"));
            background                  "$codxe_usermap_preview"
        }
        itemDef
        {
            rect                        0 -55 275 164 2 2
            decoration
            visible                     when(dvarstring("ui_codxe_usermap_count") != "0");
            textalign                   8
            textscale                   0.4
            textstyle                   6
            textfont                    1
            forecolor                   0.953 0.722 0.212 1
            exp text                    (dvarstring("ui_codxe_usermap_name"));
        }
        itemDef
        {
            rect                        0 37 58 18 2 2
            decoration
            visible                     when(HAS_MAP_AUTHOR);
            textalign                   8
            textscale                   0.3095
            textstyle                   3
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            text                        "Author:"
        }
        itemDef
        {
            rect                        58 37 217 18 2 2
            decoration
            visible                     when(HAS_MAP_AUTHOR);
            textalign                   8
            textscale                   0.3095
            textstyle                   3
            textfont                    1
            forecolor                   0.9 0.9 0.9 1
            exp text                    (dvarstring("ui_codxe_usermap_author"));
        }
        itemDef
        {
            rect                        0 37 58 18 2 2
            decoration
            visible                     when(HAS_MAP_REVISION);
            exp rect Y                  (37 + HAS_MAP_AUTHOR * 18);
            textalign                   8
            textscale                   0.3095
            textstyle                   3
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            text                        "Revision:"
        }
        itemDef
        {
            rect                        58 37 217 18 2 2
            decoration
            visible                     when(HAS_MAP_REVISION);
            exp rect Y                  (37 + HAS_MAP_AUTHOR * 18);
            textalign                   8
            textscale                   0.3095
            textstyle                   3
            textfont                    1
            forecolor                   0.9 0.9 0.9 1
            exp text                    (dvarstring("ui_codxe_usermap_revision"));
        }
        itemDef
        {
            rect                        0 65 275 1 2 2
            style                       3
            decoration
            visible                     when(HAS_MAP_METADATA && dvarstring("ui_codxe_usermap_description") != "");
            exp rect Y                  (65 + MAP_METADATA_SECOND_ROW);
            forecolor                   0.5 0.5 0.5 0.4
            background                  "menu_white_line_faded"
        }
        itemDef
        {
            rect                        0 56 275 98 2 2
            decoration
            autowrapped
            type                        1
            visible                     when(dvarstring("ui_codxe_usermap_description") != "");
            exp rect Y                  (MAP_DESCRIPTION_Y);
            exp rect H                  (154 - MAP_DESCRIPTION_Y);
            textscale                   0.33
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            exp text                    (dvarstring("ui_codxe_usermap_description"));
        }
        itemDef
        {
            rect                        0 158 275 20 2 2
            decoration
            visible                     when(dvarstring("ui_codxe_usermap_count") != "0");
            textalign                   2
            textscale                   0.3095
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            exp text                    (dvarstring("ui_codxe_usermap_count"));
        }
        itemDef
        {
            rect                        0 443 640 0.5 4 4
            style                       3
            decoration
            visible                     1
            forecolor                   0.5 0.5 0.5 0.65
            background                  "menu_white_line_faded"
        }
        itemDef
        {
            rect                        0 -20 16 16 1 3
            style                       3
            decoration
            visible                     1
            background                  "ui_arrow_left"
        }
        itemDef
        {
            text                        "@PLATFORM_BACK"
            rect                        18 -4 0 0 1 3
            decoration
            visible                     1
            textalign                   12
            textscale                   0.3095
            textfont                    1
        }
    }
}
