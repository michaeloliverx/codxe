{
    menuDef
    {
        name                        "ingameoptions"
        rect                        0 0 640 480 0 0
        borderSize                  1
        focuscolor                  0.95294 0.72156 0.21176 1
        blurWorld                   4.8
        onOpen
        {
            setdvar ui_version_show 0;
            setdvar cg_drawhud 0;
            execNow Updatedvarsfromprofile;
            setdvar valid_buttons 0;
            setdvar valid_sticks 0;
            execNowOnDvarStringValue gpad_buttonsConfig buttons_default "set valid_buttons 1";
            execNowOnDvarStringValue gpad_buttonsConfig buttons_experimental "set valid_buttons 1";
            execNowOnDvarStringValue gpad_buttonsConfig buttons_lefty "set valid_buttons 1";
            execNowOnDvarStringValue gpad_buttonsConfig buttons_nomad "set valid_buttons 1";
            execNowOnDvarStringValue gpad_sticksConfig thumbstick_default "set valid_sticks 1";
            execNowOnDvarStringValue gpad_sticksConfig thumbstick_southpaw "set valid_sticks 1";
            execNowOnDvarStringValue gpad_sticksConfig thumbstick_legacy "set valid_sticks 1";
            execNowOnDvarStringValue gpad_sticksConfig thumbstick_legacysouthpaw "set valid_sticks 1";
            execNowOnDvarIntValue valid_buttons 0 "set gpad_buttonsConfig buttons_default";
            execNowOnDvarIntValue valid_sticks 0 "set gpad_sticksConfig thumbstick_default";
            profileshow selectSaveDevice;
            setdvar ui_cheats_hint "";
            execOnDvarIntValue splitscreen 1 fullscreenview;
        }
        onClose
        {
            setdvar cg_drawhud 1;
        }
        onESC
        {
            execOnDvarIntValue splitscreen 1 splitscreenview;
            open pausedmenu;
            close self;
            setdvar cg_drawhud 1;
            exec updategamerprofile;
            exec "updatedvarsfromprofileforclient 0";
        }
        execKeyInt 14
        {
            execOnDvarIntValue splitscreen 1 splitscreenview;
            exec updategamerprofile;
            exec "updatedvarsfromprofileforclient 0";
            close self;
        }
