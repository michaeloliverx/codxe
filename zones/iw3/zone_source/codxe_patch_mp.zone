>game,IW3
>platform,xbox360
>name,patch_mp

// Extend the normal TU4 patch; the database keeps its stock name and lifetime.
localize,codxe_ui_mp
menulist,ui_mp/main.menu
menulist,ui_mp/settings_map.menu
menulist,ui_mp/patch_mp_menus.txt

// Offline class menus use materials already resident in the stock startup zones.
material,,gradient_top
material,,gradient_bottom
material,,white
material,,button_highlight_end
material,,ui_arrow_left
material,,line_horizontal
material,,gradient_fadein
material,,compass_map_default
material,,objective_line
material,,compassping_friendly
material,,compassping_enemy
material,,compassping_player

// Override the common_mp class menus at the normal TU4 patch priority.
menulist,ui_mp/scriptmenus/changeclass_marines.menu
menulist,ui_mp/scriptmenus/changeclass_opfor.menu
menulist,ui_mp/scriptmenus/changeclass_splitscreen.menu
