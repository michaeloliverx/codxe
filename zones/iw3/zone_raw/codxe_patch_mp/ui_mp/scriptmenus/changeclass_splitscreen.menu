// The preset table and the selected controller's saved classes share the same field IDs.
#define CLASS_VALUE(field) \
    int(stat(localvarint("codxe_class_preview_base") + field) * localvarint("codxe_class_preview_custom") + \
        int(tablelookup("mp/classTable.csv", 1, localvarint("codxe_class_preview_base") + field, 5)) * \
        (1 - localvarint("codxe_class_preview_custom")))

