                show name_mp_convoy;
                show desc_mp_convoy;
            }
            leaveFocus
            {
                setLocalVarInt ui_highlight 0;
            }
            action
            {
                play mouse_click;
                play mouse_click;
                setdvar ui_mapname mp_convoy;
                setdvar ui_mapname_text "@MPUI_CONVOY";
                close self;
            }
            dvarTest                    "ui_mapname"
            focusDvar                   { "mp_convoy" }
            exp text                    ("@MPUI_CONVOY");
