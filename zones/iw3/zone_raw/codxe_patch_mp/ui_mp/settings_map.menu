            textalignx                  -21
            textscale                   0.375
            textstyle                   6
            textfont                    1
            forecolor                   0.69 0.69 0.69 1
            onFocus
            {
                play mouse_over;
                setLocalVarInt ui_highlight 1;
                setLocalVarString ui_choicegroup map_selection;
                hide map_image_group;
                hide map_name_group;
                hide map_desc_group;
                setdvar ui_mapname2_text "@MPUI_CONVOY";
