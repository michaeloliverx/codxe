// Stock TU4 settings_map extended with the usermaps entry.
{
    menuDef
    {
        name                        "settings_map"
        fullscreen                  1
        rect                        0 0 640 480 0 0
        style                       1
        borderSize                  1
        focuscolor                  1 1 1 1
        soundLoop                   "music_mainmenu_mp"
        onOpen
        {
            focusFirst;
            setfocusbydvar ui_mapname;
        }
        onClose
        {
            execNow xupdatepartystate;
        }
        onESC
        {
            close settings_map;
        }
        itemDef
        {
