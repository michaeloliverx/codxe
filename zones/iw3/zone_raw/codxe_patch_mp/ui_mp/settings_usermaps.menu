#include "ui_mp/menudef.h"

#define HAS_MAP_AUTHOR (dvarstring("ui_codxe_usermap_author") != "")
#define HAS_MAP_REVISION (dvarstring("ui_codxe_usermap_revision") != "")
#define HAS_MAP_METADATA (HAS_MAP_AUTHOR || HAS_MAP_REVISION)
#define MAP_METADATA_SECOND_ROW ((HAS_MAP_AUTHOR && HAS_MAP_REVISION) * 17)
#define MAP_DESCRIPTION_Y (296 + HAS_MAP_METADATA * 21 + MAP_METADATA_SECOND_ROW)
#include "ui_mp/codxe_feeder_menu.inc"

{
    menuDef
    {
        name                        "settings_usermaps"
        fullscreen                  1
        rect                        0 0 640 480 0 0
        style                       WINDOW_STYLE_FILLED
        borderSize                  1
        focuscolor                  1 1 1 1
        soundLoop                   "music_mainmenu_mp"
        onOpen
        {
            uiScript "LoadUsermaps";
            focusFirst;
        }
        onClose
        {
            uiScript "CloseUsermaps";
        }
        onESC
        {
            close self;
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_back"
        }
        itemDef
        {
            rect                        -107 0 1708 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_fogscroll"
            exp rect X                  ((- 107) - ((float(milliseconds() % 60000) / 60000) * (854)));
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_front"
        }
        itemDef
        {
            rect                        48 40 0 0 0 0
            decoration
            borderSize                  1
            visible                     1
            textalign                   4
            textscale                   0.5833
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            forecolor                   1 0.8 0.4 1
            exp text                    ("@CODXE_CUSTOM_MAPS");
        }
        itemDef
        {
            rect                        228 40 76 18 0 0
            decoration
            borderSize                  1
            visible                     1
            textalign                   6
            textscale                   0.325
            textstyle                   ITEM_TEXTSTYLE_SHADOWED
            textfont                    UI_FONT_NORMAL
            forecolor                   0.69 0.69 0.69 1
            exp text                    (dvarString(ui_codxe_usermap_counter));
        }
        itemDef
        {
            rect                        -120 0 420 68 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "white"
        }
        itemDef
        {
            rect                        300 0 16 -68 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "button_highlight_end"
        }
        itemDef
        {
            name                        "usermap_list"
            rect                        64 84 240 322 0 0
            CODXE_FEEDER_LIST_STYLE(215, 178, 190, 2)
            feeder                      FEEDER_CODXE_USERMAPS
            execKeyInt BUTTON_X
            {
                uiScript openMenuOnDvar ui_codxe_usermap_has_tags 1 codxe_usermap_filter;
            }
            doubleClick
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
            execKeyInt 13
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
            execKeyInt BUTTON_A
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
        }
        itemDef
        {
            name "usermap_preview"
            rect 324 96 275 174 0 0
            style WINDOW_STYLE_SHADER
            decoration
            visible when(dvarint("ui_codxe_usermap_has_preview"));
            background "$codxe_usermap_preview"
        }
        itemDef
        {
            name "usermap_title"
            rect 328 80 267 20 0 0
            decoration
            autowrapped
            visible 1
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 1 0.8 0.4 1
            exp text (dvarstring("ui_codxe_usermap_name"));
        }
        itemDef
        {
            rect 328 275 60 17 0 0
            decoration
            visible when(HAS_MAP_AUTHOR);
            textalign 0
            textaligny 12
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            text "Author:"
        }
        itemDef
        {
            rect 388 275 207 17 0 0
            decoration
            visible when(HAS_MAP_AUTHOR);
            textalign 0
            textaligny 12
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_usermap_author"));
        }
        itemDef
        {
            rect 328 275 60 17 0 0
            decoration
            visible when(HAS_MAP_REVISION);
            exp rect Y (275 + HAS_MAP_AUTHOR * 17);
            textalign 0
            textaligny 12
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            text "Revision:"
        }
        itemDef
        {
            rect 388 275 207 17 0 0
            decoration
            visible when(HAS_MAP_REVISION);
            exp rect Y (275 + HAS_MAP_AUTHOR * 17);
            textalign 0
            textaligny 12
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.9 0.9 0.9 1
            exp text (dvarstring("ui_codxe_usermap_revision"));
        }
        itemDef
        {
            rect 328 298 267 1 0 0
            style WINDOW_STYLE_SHADER
            decoration
            visible when(HAS_MAP_METADATA && dvarstring("ui_codxe_usermap_description") != "");
            exp rect Y (298 + MAP_METADATA_SECOND_ROW);
            forecolor 0.5 0.5 0.5 0.4
            background "line_horizontal"
        }
        itemDef
        {
            name "usermap_description"
            rect 328 296 267 112 0 0
            decoration
            autowrapped
            visible when(dvarstring("ui_codxe_usermap_description") != "");
            exp rect Y (MAP_DESCRIPTION_Y);
            exp rect H (408 - MAP_DESCRIPTION_Y);
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            exp text (dvarstring("ui_codxe_usermap_description"));
        }
        itemDef
        {
            rect 72 100 220 48 0 0
            decoration
            autowrapped
            visible when(dvarint("ui_codxe_usermap_count") == 0);
            textscale 0.375
            text "@CODXE_NO_MAPS"
        }
        itemDef
        {
            rect                        -120 416 420 64 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "white"
        }
        itemDef
        {
            rect                        300 416 16 64 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "button_highlight_end"
        }
        itemDef
        {
            rect                        0 -20 16 16 1 3
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "ui_arrow_left"
        }
        itemDef
        {
            rect 80 -4 0 0 1 3
            decoration
            borderSize 1
            visible when(dvarbool("ui_codxe_usermap_has_tags"));
            exp text (dvarstring("ui_codxe_usermap_tag"));
            textfont UI_FONT_NORMAL
            textscale 0.375
            textalign 12
        }
        itemDef
        {
            text                        "@PLATFORM_BACK"
            rect                        18 -4 0 0 1 3
            decoration
            borderSize                  1
            visible                     1
            textalign                   12
            textscale                   0.375
            textfont                    UI_FONT_NORMAL
        }
    }

    menuDef
    {
        name "codxe_usermap_filter"
        rect -164 -136 328 272 2 2
        popup
        style 1
        visible 1
        focuscolor 1 1 1 1
        onOpen
        {
            uiScript LoadUsermapFilters;
            setfocus usermap_tags;
        }
        onESC
        {
            close self;
        }
        itemDef
        {
            rect -600 -800 2000 2000 0 0
            style 3
            decoration
            visible 1
            forecolor 0 0 0 0.65
            background "white"
        }
        itemDef
        {
            rect 0 0 328 272 2 2
            style 3
            decoration
            visible 1
            border 1
            borderSize 1
            bordercolor 0.4 0.4 0.42 1
            forecolor 0.1 0.1 0.12 0.98
            background "white"
        }
        itemDef
        {
            rect 18 5 292 26 2 2
            decoration
            visible 1
            text "Filter by Tag"
            textfont 1
            textscale 0.45
            textalign 8
        }
        itemDef
        {
            name "usermap_tags"
            rect 14 35 300 198 2 2
            CODXE_FEEDER_LIST_STYLE(274, 244, 251, 0)
            feeder 66
            doubleclick
            {
                play mouse_click;
                uiScript ApplyUsermapFilter;
                close self;
            }
            execKeyInt BUTTON_A
            {
                play mouse_click;
                uiScript ApplyUsermapFilter;
                close self;
            }
            execKeyInt 13
            {
                uiScript ApplyUsermapFilter;
                close self;
            }
            execKeyInt 2
            {
                close self;
            }
            execKeyInt 3
            {
                close self;
            }
        }
        itemDef
        {
            rect 18 239 292 24 2 2
            decoration
            visible 1
            text "@PLATFORM_BACK"
            textfont 1
            textscale 0.375
            textalign 8
        }
    }
}
