#include "ui_mp/menudef.h"
#include "ui_mp/codxe_feeder_menu.inc"

{
    menuDef
    {
        name                        "settings_usermaps"
        fullscreen                  1
        rect                        0 0 640 480 0 0
        style                       WINDOW_STYLE_FILLED
        borderSize                  1
        focuscolor                  1 1 1 1
        soundLoop                   "music_mainmenu_mp"
        onOpen
        {
            uiScript "LoadUsermaps";
            focusFirst;
        }
        onClose
        {
            uiScript "CloseUsermaps";
        }
        onESC
        {
            close self;
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_back"
        }
        itemDef
        {
            rect                        -107 0 1708 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_fogscroll"
            exp rect X                  ((- 107) - ((float(milliseconds() % 60000) / 60000) * (854)));
        }
        itemDef
        {
            rect                        -107 0 854 480 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "animbg_blur_front"
        }
        itemDef
        {
            rect                        48 40 0 0 0 0
            decoration
            borderSize                  1
            visible                     1
            textalign                   4
            textscale                   0.5833
            textstyle                   ITEM_TEXTSTYLE_SHADOWEDMORE
            textfont                    UI_FONT_NORMAL
            forecolor                   1 0.8 0.4 1
            exp text                    ("@CODXE_CUSTOM_MAPS");
        }
        itemDef
        {
            rect                        228 40 76 18 0 0
            decoration
            borderSize                  1
            visible                     1
            textalign                   6
            textscale                   0.325
            textstyle                   ITEM_TEXTSTYLE_SHADOWED
            textfont                    UI_FONT_NORMAL
            forecolor                   0.69 0.69 0.69 1
            exp text                    (dvarString(ui_codxe_usermap_counter));
        }
        itemDef
        {
            rect                        -120 0 420 68 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "white"
        }
        itemDef
        {
            rect                        300 0 16 -68 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "button_highlight_end"
        }
        itemDef
        {
            name                        "usermap_list"
            rect                        64 84 240 322 0 0
            CODXE_FEEDER_LIST_STYLE
            feeder                      FEEDER_CODXE_USERMAPS
            doubleClick
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
            execKeyInt 13
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
            execKeyInt BUTTON_A
            {
                play mouse_click;
                uiScript "ApplyMap";
                close settings_map;
                close self;
            }
        }
        itemDef
        {
            name "usermap_preview"
            rect 324 96 275 174 0 0
            style WINDOW_STYLE_SHADER
            decoration
            visible when(dvarint("ui_codxe_usermap_has_preview"));
            background "$codxe_usermap_preview"
        }
        itemDef
        {
            name "usermap_title"
            rect 328 80 267 20 0 0
            decoration
            autowrapped
            visible 1
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 1 0.8 0.4 1
            exp text (dvarstring("ui_codxe_usermap_name"));
        }
        itemDef
        {
            name "usermap_description"
            rect 328 296 267 112 0 0
            decoration
            autowrapped
            visible 1
            textscale 0.375
            textstyle ITEM_TEXTSTYLE_SHADOWED
            forecolor 0.69 0.69 0.69 1
            exp text (dvarstring("ui_codxe_usermap_description"));
        }
        itemDef
        {
            rect 72 100 220 48 0 0
            decoration
            autowrapped
            visible when(dvarint("ui_codxe_usermap_count") == 0);
            textscale 0.375
            text "@CODXE_NO_MAPS"
        }
        itemDef
        {
            rect                        -120 416 420 64 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "white"
        }
        itemDef
        {
            rect                        300 416 16 64 0 0
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            forecolor                   0.9 0.9 0.95 0.175
            background                  "button_highlight_end"
        }
        itemDef
        {
            rect                        0 -20 16 16 1 3
            style                       WINDOW_STYLE_SHADER
            decoration
            borderSize                  1
            visible                     1
            textscale                   0.55
            background                  "ui_arrow_left"
        }
        itemDef
        {
            text                        "@PLATFORM_BACK"
            rect                        18 -4 0 0 1 3
            decoration
            borderSize                  1
            visible                     1
            textalign                   12
            textscale                   0.375
            textfont                    UI_FONT_NORMAL
        }
    }
}
